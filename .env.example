OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_MAPS_API_KEY=

# Opt in to redacted diagnostics in trace and artifacts/llm-diagnostics.jsonl
OPENAI_DIAGNOSTICS=0

# Bounded model turns (3-20); default 12
AGENT_MAX_ITERATIONS=12

# OSM public services: server-side, low-volume user-triggered lookups only
OSM_USER_AGENT=PerfectSaturdayPlanner/1.0 (+https://github.com/rishabh-soni/perfect-saturday-planner)
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_SEARCH_RADIUS_METERS=2500
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# Shared by all processes on ONE host; use a centralized geocoding proxy for multiple hosts
PROVIDER_CACHE_PATH=artifacts/provider-cache.sqlite3
# Short-distance conservative fallback only; 0 disables it
ROUTING_FALLBACK=1
# Set the actual app origin before hosting; used for map document base / Referer
APP_PUBLIC_URL=http://127.0.0.1:8501/
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>
